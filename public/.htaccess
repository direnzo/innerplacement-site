# Redirecionamentos 301 das URLs do WordPress atual para as páginas novas.
# RedirectMatch ancorado (^...$), não Redirect: o Redirect do Apache anexa o resto do caminho ao destino
# (/depoimento/nome/ viraria /depoimentos/nome/, que não existe). A barra final é opcional (/?).
# Testado em Apache 2.4 local contra as 45 URLs dos sitemaps do WordPress (docs/mapa-redirecionamentos.md).
RewriteEngine On
# HTTPS e domínio sem www: no WordPress, isso vinha de um plugin e do próprio WordPress. A exceção mantém a renovação do SSL.
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://innerplacement.com.br%{REQUEST_URI} [L,R=301]
# index.html pedido explicitamente vai para a URL canônica. THE_REQUEST olha só o pedido original, para não entrar em laço com o DirectoryIndex.
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:[^?\s]*/)?index\.html[?\s]
RewriteRule ^(.*/)?index\.html$ https://innerplacement.com.br/$1 [L,R=301]
Options -Indexes
RedirectMatch 301 ^/profissionais-transicao-de-carreira-outplacement/?$ /para-voce/transicao-e-recolocacao/
RedirectMatch 301 ^/profissionais-evolucao-de-carreira/?$ /para-voce/next-level/
RedirectMatch 301 ^/empresas-desenvolvimento-de-executivos/?$ /para-sua-empresa/next-level/
RedirectMatch 301 ^/empresas?/?$ /para-sua-empresa/outplacement/
RedirectMatch 301 ^/profissionais/?$ /para-voce/
# Endereços anteriores das páginas de serviço (só existiram na versão de teste; doc. v2, 3.6)
RedirectMatch 301 ^/transicao-e-recolocacao/?$ /para-voce/transicao-e-recolocacao/
RedirectMatch 301 ^/desenvolvimento-de-carreira/?$ /para-voce/next-level/
RedirectMatch 301 ^/desenvolvimento-de-executivos/?$ /para-sua-empresa/next-level/
RedirectMatch 301 ^/outplacement/?$ /para-sua-empresa/outplacement/
RedirectMatch 301 ^/faq/?$ /perguntas-frequentes/
RedirectMatch 301 ^/sitemap(_index)?\.xml$ /sitemap-index.xml
# Depoimentos individuais do WordPress (14) agora vivem na página única
RedirectMatch 301 ^/depoimento(/.*)?$ /depoimentos/
# Páginas de apoio do WordPress
RedirectMatch 301 ^/politica-de-cookies-br/?$ /politica-de-privacidade/
RedirectMatch 301 ^/termos-e-condicoes/?$ /politica-de-privacidade/
RedirectMatch 301 ^/endereços(/.*)?$ /contato/
# Arquivos do blog do WordPress
RedirectMatch 301 ^/(category|author)(/.*)?$ /blog/
ErrorDocument 404 /404.html

# Compressão de texto (imagens, PDF e fontes woff2 já são comprimidos)
<IfModule mod_filter.c>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
</IfModule>

# Cache: HTML e arquivos de índice sempre revalidados; imagens por um mês. Só os tipos listados: o painel /admin não entra.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/plain "access plus 0 seconds"
ExpiresByType application/xml "access plus 0 seconds"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType image/avif "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
# Cabeçalhos de segurança. HSTS por 30 dias e sem subdomínios: o teste e o IQA têm certificado e vida próprios.
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Strict-Transport-Security "max-age=2592000" "expr=%{HTTPS} == 'on'"
</IfModule>
# _astro/: o nome do arquivo muda quando o conteúdo muda, então o cache pode ser definitivo.
<IfModule mod_setenvif.c>
<IfModule mod_headers.c>
SetEnvIf Request_URI "^/_astro/" arquivo_com_hash
Header set Cache-Control "public, max-age=31536000, immutable" env=arquivo_com_hash
</IfModule>
</IfModule>

# Blocos gerados pelo cPanel, copiados do .htaccess do WordPress em 08/11/2026: mantêm o PHP do enviar.php (8.2).
# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_flag display_errors Off
   php_value max_execution_time 240
   php_value max_input_time 240
   php_value max_input_vars 1000
   php_value memory_limit 2024M
   php_value post_max_size 2024M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php82"
   php_value upload_max_filesize 512M
   php_flag zlib.output_compression On
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors Off
   php_value max_execution_time 240
   php_value max_input_time 240
   php_value max_input_vars 1000
   php_value memory_limit 2024M
   php_value post_max_size 2024M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php82"
   php_value upload_max_filesize 512M
   php_flag zlib.output_compression On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Defina o pacote “ea-php82” como a linguagem padrão de programação “PHP”.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
