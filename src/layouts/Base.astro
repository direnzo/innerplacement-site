---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Fechamento from '../components/Fechamento.astro';
import WhatsFlutuante from '../components/WhatsFlutuante.astro';
import Sprite from '../components/Sprite.astro';
import { EMAIL, WHATSAPP_TXT } from '../data/site';
interface Props { titulo: string; descricao: string; fechamento?: boolean; schema?: object }
const { titulo, descricao, fechamento = false, schema } = Astro.props;
const tituloCompleto = Astro.url.pathname === '/' ? `Inner Placement · ${titulo}` : `${titulo} · Inner Placement`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const org = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'Inner Placement',
  url: 'https://innerplacement.com.br/', email: EMAIL, telephone: WHATSAPP_TXT,
  areaServed: 'BR', address: [
    { '@type': 'PostalAddress', streetAddress: 'Av. Tabapuã, 500, cj. 32, Itaim Bibi', addressLocality: 'São Paulo', addressRegion: 'SP', addressCountry: 'BR' },
    { '@type': 'PostalAddress', streetAddress: 'R. Visconde do Rio Branco, 1358, cj. 703, Centro', addressLocality: 'Curitiba', addressRegion: 'PR', addressCountry: 'BR' },
  ],
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descricao} />
  <meta property="og:url" content={canonical} />
  <meta name="theme-color" content="#FFFFFF" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;600;700&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify(schema ?? org)} />
  <slot name="head" />
</head>
<body class="min-h-dvh">
  <Sprite />
  <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-5 focus:py-3">Pular para o conteúdo</a>
  <Header />
  <main id="conteudo" class="flex flex-col gap-6 pb-6 md:gap-8">
    <slot />
    {fechamento && <Fechamento />}
  </main>
  <Footer />
  <WhatsFlutuante />
  <script>
    import '../scripts/app.ts';
  </script>
</body>
</html>
