---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Fechamento from '../components/Fechamento.astro';
import WhatsFlutuante from '../components/WhatsFlutuante.astro';
import Sprite from '../components/Sprite.astro';
import FormaFundo from '../components/FormaFundo.astro';
import fBola from '../../imagens/inner-F01-bola-v1.svg?raw';
import fArcos from '../../imagens/inner-F02-arcos-v1.svg?raw';
import fSetas from '../../imagens/inner-F03-chevrons-v1.svg?raw';
import fOval from '../../imagens/inner-F04-oval-v1.svg?raw';
import { EMAIL, WHATSAPP_TXT } from '../data/site';
// fundo: formas da marca flutuando nas bordas de todas as páginas (pedido do dono, 01/10); a home desliga
// (fundo={false}) porque tem as suas, posicionadas à mão no bloco 2.
interface Props { titulo: string; descricao: string; fechamento?: boolean; schema?: object; fundo?: boolean }
const { titulo, descricao, fechamento = false, schema, fundo = true } = Astro.props;
const tituloCompleto = Astro.url.pathname === '/' ? `Inner Placement · ${titulo}` : `${titulo} · Inner Placement`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Imagem de compartilhamento (public/og/, gerada por tools/compartilhamento.mts). Páginas sem imagem
// própria (o Agradecimento) usam a da home.
const pagina = Astro.url.pathname.replace(/^\/|\/$/g, '') || 'inicio';
const comImagem = ['inicio', 'transicao-e-recolocacao', 'desenvolvimento-de-carreira', 'desenvolvimento-de-executivos', 'outplacement', 'depoimentos', 'perguntas-frequentes', 'manifesto', 'contato', 'quem-somos'];
const ogImagem = new URL(`/og/${comImagem.includes(pagina) ? pagina : 'inicio'}.jpg`, Astro.site).href;
const org = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'Inner Placement',
  url: 'https://innerplacement.com.br/', email: EMAIL, telephone: WHATSAPP_TXT,
  areaServed: 'BR', address: [
    { '@type': 'PostalAddress', streetAddress: 'Av. Tabapuã, 500, cj. 32, Itaim Bibi', addressLocality: 'São Paulo', addressRegion: 'SP', addressCountry: 'BR' },
    { '@type': 'PostalAddress', streetAddress: 'R. Visconde do Rio Branco, 1358, cj. 703, Centro', addressLocality: 'Curitiba', addressRegion: 'PR', addressCountry: 'BR' },
  ],
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descricao} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Inner Placement" />
  <meta property="og:image" content={ogImagem} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${titulo} · Inner Placement`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#FFFFFF" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;600;700&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify(schema ?? org)} />
  <slot name="head" />
</head>
<body class="min-h-dvh">
  <Sprite />
  <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-5 focus:py-3">Pular para o conteúdo</a>
  <Header />
  <main id="conteudo" class="relative isolate flex flex-col gap-6 overflow-clip pb-6 md:gap-8">
    {fundo && <>
      <FormaFundo svg={fBola} viewBox="0 0 400 400" class="-right-40 top-[16%] w-[340px] md:-right-32 md:w-[520px]" />
      <FormaFundo svg={fOval} viewBox="0 0 200 280" class="-left-24 top-[36%] w-[150px] opacity-50 md:-left-16 md:w-[210px]" />
      <FormaFundo svg={fSetas} viewBox="0 0 240 120" class="-left-10 top-[62%] w-[160px] opacity-30 md:w-[230px]" />
      <FormaFundo svg={fArcos} viewBox="0 0 400 400" class="-right-24 top-[76%] w-[280px] md:-right-16 md:w-[420px]" />
    </>}
    <slot />
    {fechamento && <Fechamento />}
  </main>
  <Footer />
  <WhatsFlutuante />
  <script>
    import '../scripts/app.ts';
  </script>
</body>
</html>
