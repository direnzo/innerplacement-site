---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Fechamento from '../components/Fechamento.astro';
import type { Props as PropsFechamento } from '../components/Fechamento.astro';
import WhatsFlutuante from '../components/WhatsFlutuante.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Sprite from '../components/Sprite.astro';
import FormaFundo from '../components/FormaFundo.astro';
import fBola from '../../imagens/inner-F01-bola-v1.svg?raw';
import fArcos from '../../imagens/inner-F02-arcos-v1.svg?raw';
import fSetas from '../../imagens/inner-F03-chevrons-v1.svg?raw';
import fOval from '../../imagens/inner-F04-oval-v1.svg?raw';
import { EMAIL, WHATSAPP_TXT, GTM_ID, enderecos, redes } from '../data/site';
// fundo: formas da marca flutuando nas bordas de todas as páginas (pedido do dono, 01/10); a home desliga
// (fundo={false}) porque tem as suas, posicionadas à mão no bloco 2.
// ogImagem: caminho de uma imagem de compartilhamento própria (posts do blog: a capa). tipo: og:type.
interface Props { titulo: string; descricao: string; fechamento?: boolean | PropsFechamento; schema?: object; fundo?: boolean; ogImagem?: string; tipo?: 'website' | 'article' }
const { titulo, descricao, fechamento = false, schema, fundo = true, ogImagem: ogPropria, tipo = 'website' } = Astro.props;
const tituloCompleto = Astro.url.pathname === '/' ? `Inner Placement · ${titulo}` : `${titulo} · Inner Placement`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Imagem de compartilhamento (public/og/, gerada por tools/compartilhamento.mts). Páginas sem imagem
// própria (o Agradecimento) usam a da home.
const pagina = Astro.url.pathname.replace(/^\/|\/$/g, '').replace('/', '--') || 'inicio';
const comImagem = ['inicio', 'para-voce--transicao-e-recolocacao', 'para-voce--next-level', 'para-sua-empresa--next-level', 'para-sua-empresa--outplacement', 'para-sua-empresa', 'para-voce', 'para-sua-empresa--executive-alignment', 'depoimentos', 'perguntas-frequentes', 'manifesto', 'contato', 'quem-somos', 'blog'];
const ogImagem = new URL(ogPropria ?? `/og/${comImagem.includes(pagina) ? pagina : 'inicio'}.jpg`, Astro.site).href;
const org = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', '@id': 'https://innerplacement.com.br/#organizacao', name: 'Inner Placement',
  url: 'https://innerplacement.com.br/', logo: 'https://innerplacement.com.br/logo.svg', image: 'https://innerplacement.com.br/og/inicio.jpg',
  sameAs: redes.map((r) => r.href), email: EMAIL, telephone: WHATSAPP_TXT,
  areaServed: 'BR', address: enderecos.map((e) => ({
    '@type': 'PostalAddress', streetAddress: `${e.rua}, ${e.bairro}`, addressLocality: e.cidade, addressRegion: e.uf, addressCountry: 'BR',
  })),
};
// A home (sem schema próprio) também declara o site, ligado à organização pelo @id.
const site = {
  '@context': 'https://schema.org', '@type': 'WebSite', '@id': 'https://innerplacement.com.br/#site', url: 'https://innerplacement.com.br/',
  name: 'Inner Placement', inLanguage: 'pt-BR', publisher: { '@id': 'https://innerplacement.com.br/#organizacao' },
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <!-- Consent Mode do Google: nega a medição por padrão: só o aviso de cookies (CookieConsent.astro) libera,
       por categoria, guardando a escolha para as próximas páginas. O Gerenciador de Tags (GTM_ID em
       src/data/site.ts) carrega sempre, mas sem medir nada até a permissão ser dada. -->
  <script is:inline define:vars={{ GTM_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', wait_for_update: 500 });
    try {
      var p = JSON.parse(localStorage.getItem('cookies-inner') || 'null');
      if (p) gtag('consent', 'update', { analytics_storage: p.estatisticas ? 'granted' : 'denied', ad_storage: p.marketing ? 'granted' : 'denied', ad_user_data: p.marketing ? 'granted' : 'denied', ad_personalization: p.marketing ? 'granted' : 'denied' });
    } catch (e) {}
    (function (w, d, s, l, i) {
      w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
      j.async = true; j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', GTM_ID);
  </script>
  <title>{tituloCompleto}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={tipo} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descricao} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Inner Placement" />
  <meta property="og:image" content={ogImagem} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${titulo} · Inner Placement`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@innerplacement" />
  <meta name="twitter:title" content={tituloCompleto} />
  <meta name="twitter:description" content={descricao} />
  <meta name="twitter:image" content={ogImagem} />
  <!-- Selo de localização (SEO local), igual ao que o site antigo tinha: endereço de São Paulo. -->
  <meta name="geo.placename" content="São Paulo" />
  <meta name="geo.position" content="-23.5829239;-46.6781108" />
  <meta name="geo.region" content="BR-SP" />
  <meta name="theme-color" content="#FFFFFF" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;600;700&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify(schema ?? (Astro.url.pathname === '/' ? [org, site] : org))} />
  <slot name="head" />
</head>
<body class="min-h-dvh">
  <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden" title="Gerenciador de Tags do Google"></iframe></noscript>
  <Sprite />
  <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-5 focus:py-3">Pular para o conteúdo</a>
  <Header />
  <main id="conteudo" class="relative isolate flex flex-col gap-6 overflow-clip pb-6 md:gap-8">
    {fundo && <>
      <FormaFundo svg={fBola} viewBox="0 0 400 400" class="-right-40 top-[16%] w-[340px] md:-right-32 md:w-[520px]" />
      <FormaFundo svg={fOval} viewBox="0 0 200 280" class="-left-24 top-[36%] w-[150px] opacity-50 md:-left-16 md:w-[210px]" />
      <FormaFundo svg={fSetas} viewBox="0 0 240 120" class="-left-10 top-[62%] w-[160px] opacity-30 md:w-[230px]" />
      <FormaFundo svg={fArcos} viewBox="0 0 400 400" class="-right-24 top-[76%] w-[280px] md:-right-16 md:w-[420px]" />
    </>}
    <slot />
    {fechamento && <Fechamento {...(fechamento === true ? {} : fechamento)} />}
  </main>
  <Footer />
  <WhatsFlutuante />
  <CookieConsent />
  <script>
    import '../scripts/app.ts';
  </script>
</body>
</html>
