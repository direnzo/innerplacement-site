---
import Svg from './Svg.astro';
import { miolo } from '../lib/svg';
import { trilhaSchema } from '../lib/schema';
// ilustracao: cena do topo (tools/ilustracao/bloco4.mts, texto cru), à direita do título no computador
// e no tablet; no celular some, para o título subir (guia de imagens). Sem ela, o acento do kit.
// migalhas: breadcrumb das páginas por público ([nome, link], a última sem link); kicker: linha acima do h1;
// destaque: frase de destaque (h2) das páginas de programa (doc. v2, 3.5 e 6.1).
interface Props { titulo: string; intro?: string | string[]; trilha?: string; migalhas?: [string, string?][]; kicker?: string; destaque?: string; acento?: string; acentoStyle?: string; acentoClass?: string; ilustracao?: string; umaLinha?: boolean }
const trilhaGoogle = Astro.props.migalhas && trilhaSchema(Astro.props.migalhas, Astro.site);
const { titulo, intro, trilha, migalhas, kicker, destaque, acento, acentoStyle, acentoClass, ilustracao, umaLinha = false } = Astro.props;
---
<!-- Com ilustração, o topo tem altura mínima para a cena (180 de altura) caber inteira, com o texto
     centralizado. Banner mais baixo (pedido do dono, 02/10): 60% da altura e da cena de antes. -->
{trilhaGoogle && <script type="application/ld+json" set:html={JSON.stringify(trilhaGoogle)} />}
<section class:list={['relative overflow-hidden bg-areia-c', ilustracao && 'md:flex md:min-h-[230px] md:items-center']}>
  {ilustracao
    ? <svg viewBox="0 0 420 300" class="topo-ilus absolute right-[max(16px,calc((100%-1120px)/2))] top-1/2 hidden w-[min(27%,300px)] -translate-y-1/2 md:block" aria-hidden="true" data-entrada set:html={miolo(ilustracao)} />
    : acento === 'card_degrade'
    ? <div class="pointer-events-none absolute bottom-6 right-6 top-6 hidden overflow-hidden rounded-[28px] md:block lg:right-10"><Svg name="card_degrade" w={420} class="h-full w-auto" /></div>
    : acento && <Svg name={acento} w={420} class={`pointer-events-none absolute hidden h-auto md:block ${acentoClass ?? ''}`} style={acentoStyle} />}
  <div class:list={['wrap relative flex flex-col gap-3 py-9 md:gap-4 md:py-14 md:pr-[min(29%,320px)]', ilustracao ? 'lg:pr-[min(32%,350px)]' : 'lg:pr-0']}>
    {trilha && <p class="text-[14px] text-mudo"><a href="/" class="-my-3 inline-block py-3 hover:text-tinta">Início</a> / {trilha}</p>}
    {migalhas && (
      <nav aria-label="Trilha" class="text-[14px] text-mudo">
        <a href="/" class="-my-3 inline-block py-3 hover:text-tinta">Início</a>
        {migalhas.map(([n, h]) => <> › {h ? <a href={h} class="-my-3 inline-block py-3 hover:text-tinta">{n}</a> : n}</>)}
      </nav>
    )}
    {kicker && <p class="text-[12.5px] font-bold uppercase tracking-[.1em] text-coral-d">{kicker}</p>}
    <h1 class:list={['h1-pag', umaLinha ? 'max-w-none lg:whitespace-nowrap' : 'max-w-[20ch]']}><slot name="titulo">{titulo}</slot></h1>
    {destaque && <h2 class="h2 !font-semibold md:max-w-[34ch]">{destaque}</h2>}
    {[intro ?? []].flat().map((p) => <p class="lead md:max-w-[58ch]">{p}</p>)}
    <slot />
  </div>
</section>
