---
import Badge from './Badge.astro';
import ComIcone from './ComIcone.astro';
import tPlatinum from '../../imagens/inner-T-platinum-v1.svg?raw';
import tFocus from '../../imagens/inner-T-focus-v1.svg?raw';
import Svg from './Svg.astro';
// Card de formato das páginas de Transition (doc. v2, 6.1): etiqueta, nome, frase em destaque e texto.
// para: como no site antigo, pessoa = texto tinta e rosácea coral; empresa = texto coral e rosácea tinta translúcida.
interface Props { rotulo: string; nome: string; destaque: string; para?: 'pessoa' | 'empresa' }
const { rotulo, nome, destaque, para = 'pessoa' } = Astro.props;
// Ícone do título pelo nome do formato (tools/ilustracao/titulos.mts).
const icone = ({ 'Transition Platinum': tPlatinum, 'Transition Focus': tFocus } as Record<string, string>)[nome];
---
<article class="card flex flex-col gap-3 p-5 md:p-7">
  <Badge>{rotulo}</Badge>
  <ComIcone svg={icone}><h2 class="prog-logo" data-para={para}><span class="pl-nome">{nome}</span><Svg name="rosacea_coral" w={60} class="pl-ros" /></h2></ComIcone>
  <p class="text-[17px] font-semibold leading-[1.4]">{destaque}</p>
  <div class="flex flex-col gap-3 text-[15.5px] leading-[1.62] text-texto"><slot /></div>
</article>
