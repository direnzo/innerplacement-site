---
import type { Pergunta } from '../data/faq';
import { paragrafos } from '../data/faq';
interface Props { itens: Pergunta[]; abrirPrimeira?: boolean; prefixo: string }
const { itens, abrirPrimeira = false, prefixo } = Astro.props;
// <details> nativo: a resposta fica no HTML sem display:none, e o name deixa só uma aberta por grupo.
---
<div class="flex flex-col rounded-[20px] bg-white px-5 md:px-7">
  {itens.map((p, i) => (
    <details name={`acordeao-${prefixo}`} open={abrirPrimeira && i === 0} class:list={['group', i > 0 && 'border-t border-linha']}>
      <summary class="flex min-h-[60px] w-full cursor-pointer list-none items-center justify-between gap-4 py-3.5 text-left [&::-webkit-details-marker]:hidden">
        <h3 class="text-wrap text-[15.5px] font-semibold md:text-[16.5px]">{p.q}</h3>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          class="shrink-0 text-coral-d transition-transform group-open:rotate-180"><path d="M6 9l6 6 6-6"/></svg>
      </summary>
      <div class="flex flex-col gap-2.5 pb-5 pr-2 text-[15px] leading-[1.62] text-texto md:pr-12 md:text-[15.5px]">{paragrafos(p, Astro.url.pathname).map((par) => <p set:html={par} />)}</div>
    </details>
  ))}
</div>
