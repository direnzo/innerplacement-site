---
import Svg from './Svg.astro';
import Badge from './Badge.astro';
import ComIcone from './ComIcone.astro';
import tClientes from '../../imagens/inner-T-clientes-v1.svg?raw';
import { kit } from '../data/kit';
import { logos } from '../data/site';
const cap = (id: string, h: number, wmax: number) => {
  const k = kit['logo_' + id]; let w = h * k.w / k.h;
  if (w > wmax) { w = wmax; h = w * k.h / k.w; }
  return { w: +w.toFixed(1), h: +h.toFixed(1) };
};
---
<section class="wrap" aria-labelledby="clientes-titulo">
  <div class="flex flex-col gap-5 rounded-[28px] bg-white p-5 md:gap-6 md:p-9">
    <!-- Selo "Clientes": texto novo, aprovado pelo dono em 30/09 (não está na documentação funcional). -->
    <div class="flex flex-col gap-3"><Badge>Clientes</Badge><ComIcone svg={tClientes}><h2 id="clientes-titulo" class="h2">Alguns dos <strong>nossos clientes</strong></h2></ComIcone></div>
    <!-- Carrossel de logos (revisão 30/09, item 6): mesma mecânica do carrossel de depoimentos
         (data-carrossel em app.ts); data-sem-embaralhar mantém a ordem oficial e data-auto liga o
         avanço automático, parado com "reduzir movimento", ao passar o mouse, ao focar ou ao tocar. -->
    <div data-carrossel-caixa class="overflow-visible">
      <ul class="logos -mx-1 flex snap-x snap-mandatory gap-2 overflow-x-auto overflow-y-visible px-1 pb-3 pt-1 [scrollbar-width:none] md:mx-0 md:gap-3.5 md:px-0 [&::-webkit-scrollbar]:hidden" role="list" data-entrada data-carrossel data-sem-embaralhar data-auto>
        {logos.map((l, i) => {
          const m = cap(l.id, l.h * 0.56, 112), d = cap(l.id, l.h, 150);
          return (
            <li class="logo flex h-[56px] w-[148px] shrink-0 snap-start items-center justify-center rounded-[20px] bg-areia-c text-tinta md:h-[100px] md:w-[200px]" style={`--i:${i}`} data-autorizado={l.autorizado ? 'sim' : 'pendente'}>
              <Svg name={'logo_' + l.id} w={d.w} h={d.h} label={l.nome} class="h-[var(--hm)] w-auto md:h-[var(--hd)]" style={`--hm:${m.h}px;--hd:${d.h}px`} />
            </li>
          );
        })}
      </ul>
      <div class="mt-3 hidden justify-end gap-2 md:flex">
        <button type="button" class="carrossel-seta" data-carrossel-anterior aria-label="Logos anteriores">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="carrossel-seta" data-carrossel-proximo aria-label="Mais logos">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>
