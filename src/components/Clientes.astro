---
import Svg from './Svg.astro';
import { kit } from '../data/kit';
import { logos } from '../data/site';
const cap = (id: string, h: number, wmax: number) => {
  const k = kit['logo_' + id]; let w = h * k.w / k.h;
  if (w > wmax) { w = wmax; h = w * k.h / k.w; }
  return { w: +w.toFixed(1), h: +h.toFixed(1) };
};
---
<ul class="logos mx-auto grid w-full max-w-[820px] grid-cols-3 gap-2 md:gap-3.5" role="list" aria-label="Clientes" data-entrada>
  {logos.map((l, i) => {
    const m = cap(l.id, l.h * 0.56, 84), d = cap(l.id, l.h, 150);
    return (
      <li class="logo flex h-[56px] items-center justify-center rounded-[20px] bg-white text-tinta md:h-[100px]" style={`--i:${i}`} data-autorizado={l.autorizado ? 'sim' : 'pendente'}>
        <Svg name={'logo_' + l.id} w={d.w} h={d.h} label={l.nome} class="h-[var(--hm)] w-auto md:h-[var(--hd)]" style={`--hm:${m.h}px;--hd:${d.h}px`} />
      </li>
    );
  })}
</ul>
