---
// Título de seção com ícone ao lado (tools/ilustracao/titulos.mts, formato do H-09).
// O ícone entra quando aparece ([data-entrada]) e reage ao hover (CSS "Títulos · movimento").
import { miolo } from '../lib/svg';
interface Props { svg: string; class?: string }
const { svg, class: cls } = Astro.props;
---
<div class:list={['flex items-center gap-3 md:gap-4', cls]}>
  <svg viewBox="0 0 140 104" class="h-[56px] w-auto shrink-0 md:h-[72px]" aria-hidden="true" data-entrada set:html={miolo(svg)} />
  <slot />
</div>
