---
import Svg from './Svg.astro';
import Badge from './Badge.astro';
import Seta from './Seta.astro';
import { rotas } from '../data/site';
const blocos = [
  { tema: 'coral', titulo: 'Para você', fig: 'pessoa_up', figH: 0.74,
    texto: 'Para quem construiu uma carreira sólida e quer chegar ao próximo nível. E para quem encerrou um ciclo e precisa decidir, com estratégia, o próximo passo.',
    links: [['Quero crescer onde estou', rotas.carreira], ['Estou saindo, ou já saí', rotas.transicao]] },
  { tema: 'tinta', titulo: 'Para sua empresa', fig: 'pessoas', figH: 0.52,
    texto: 'Para empresas que cuidam da carreira das pessoas nos dois momentos: quando alguém precisa crescer, preparando executivos para responsabilidades maiores; e quando alguém sai, conduzindo o desligamento com responsabilidade.',
    links: [['Preparar quem precisa crescer', rotas.executivos], ['Cuidar de quem sai', rotas.outplacement]] },
];
---
<div class="wrap grid gap-3.5 md:grid-cols-2 md:gap-6">
  {blocos.map((b) => {
    const coral = b.tema === 'coral';
    return (
      <section aria-label={b.titulo} class:list={['relative flex flex-col gap-4 overflow-hidden rounded-[28px] p-5 pb-5 md:px-[30px] md:pb-6 md:pt-[26px]', coral ? 'bg-coral text-tinta' : 'bg-tinta text-white']}>
        <div class="flex items-center justify-between gap-3 md:block">
          <h2 class="contents"><Badge variante={coral ? 'tinta' : 'coral'}>{b.titulo}</Badge></h2>
          <div class="flex size-14 shrink-0 items-end justify-center overflow-hidden rounded-full bg-areia-c [--d:56px] md:absolute md:right-[26px] md:top-6 md:size-[88px] md:[--d:88px]">
            <Svg name={b.fig} h={Math.round(88 * b.figH)} class="-mb-0.5 w-auto" style={`height:calc(var(--d) * ${b.figH})`} />
          </div>
        </div>
        <p class:list={['text-[15px] leading-[1.58] md:max-w-[390px] md:text-[16px]', coral ? 'text-tinta' : 'text-white/80']}>{b.texto}</p>
        <nav aria-label={`Caminhos ${b.titulo.toLowerCase()}`} class="mt-auto flex flex-col gap-2.5">
          {b.links.map(([t, h]) => (
            <a href={h} class:list={['via', coral ? 'bg-white text-tinta' : 'bg-white/[.07] text-white shadow-[inset_0_0_0_1.5px_rgba(255,255,255,.22)] hover:bg-white/[.12]']}>
              {t}
              <span class:list={['via-seta', coral ? 'bg-tinta text-white' : 'bg-coral text-tinta']}><Seta /></span>
            </a>
          ))}
        </nav>
      </section>
    );
  })}
</div>
