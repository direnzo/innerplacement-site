---
import Svg from './Svg.astro';
import { EMAIL, WHATSAPP_TXT, TELEFONE_LINK, rotas, enderecos, mapsHref, redes, publicos } from '../data/site';
const cols = [
  ...[publicos[1], publicos[0]].map((g) => ({ t: g.grupo, l: g.itens.map((i) => [i.nome, i.href]) })),
  { t: 'Inner', l: [['Manifesto', rotas.manifesto], ['Quem somos', rotas.quemSomos], ['Depoimentos', rotas.depoimentos], ['Perguntas frequentes', rotas.faq], ['Blog', rotas.blog]] },
];
const ext = (h: string) => h.startsWith('http');
// Ícones das redes (24×24, mesmo espírito do LinkedIn já usado em Quem somos: um traço sólido só).
const ICONES: Record<string, string> = {
