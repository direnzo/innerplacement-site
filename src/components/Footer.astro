---
import Svg from './Svg.astro';
import { EMAIL, CIDADES, WHATSAPP_TXT, TELEFONE_LINK, rotas } from '../data/site';
const cols = [
  { t: 'Profissionais', l: [['Desenvolvimento de Carreira', rotas.carreira], ['Transição e Recolocação', rotas.transicao]] },
  { t: 'Empresas', l: [['Desenvolvimento de Executivos', rotas.executivos], ['Outplacement', rotas.outplacement]] },
  { t: 'Inner', l: [['Manifesto', rotas.manifesto], ['Quem somos', rotas.quemSomos], ['Depoimentos', rotas.depoimentos], ['Perguntas frequentes', rotas.faq], ['Blog', rotas.blog]] },
];
const ext = (h: string) => h.startsWith('http');
---
<!-- pb maior no computador tb: o botão flutuante do WhatsApp fica por cima da última linha (política de
     privacidade / preferências de cookies) quando a página rola até o fim, sem essa folga. -->
<footer class="pb-24 pt-10 text-[15px] leading-[1.5] lg:pb-28 lg:pt-12">
  <div class="wrap flex flex-col gap-8">
    <div class="grid grid-cols-2 gap-x-5 gap-y-7 lg:grid-cols-[240px_repeat(3,minmax(0,1fr))_auto] lg:gap-8">
      <div class="col-span-2 flex flex-col gap-3 lg:col-span-1">
        <Svg name="logo" h={42} label="Inner Placement" />
        <span class="text-texto">{CIDADES}</span>
      </div>
      {cols.map((c) => (
        <div class="flex flex-col">
          <span class="pb-2 font-semibold">{c.t}</span>
          {c.l.map(([n, h]) => <a href={h} class="py-1 text-texto hover:text-tinta" target={ext(h) ? '_blank' : undefined} rel={ext(h) ? 'noopener' : undefined}>{n}</a>)}
        </div>
      ))}
      <!-- col-span-2 no celular (como a logo): dá largura de sobra para o telefone e o e-mail não
           quebrarem linha; no computador, lg:w-max deixa a coluna só do tamanho do texto. -->
      <div class="col-span-2 flex flex-col lg:col-span-1 lg:w-max">
        <span class="pb-2 font-semibold">Contato</span>
        <a href={TELEFONE_LINK} class="whitespace-nowrap py-1 text-texto hover:text-tinta">{WHATSAPP_TXT}</a>
        <a href={rotas.contato} class="whitespace-nowrap py-1 text-texto hover:text-tinta">{EMAIL}</a>
      </div>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-x-5 gap-y-2 border-t border-tinta/15 pt-5 text-[13.5px] text-texto">
      <span>© {new Date().getFullYear()} Inner Placement</span>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a href={rotas.privacidade} class="hover:text-tinta">Política de privacidade</a>
        <button type="button" id="abrir-cookies" class="hover:text-tinta">Preferências de cookies</button>
      </div>
    </div>
  </div>
</footer>
