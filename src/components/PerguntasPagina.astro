---
import Acordeao from './Acordeao.astro';
import { perguntas, faqSchema } from '../data/faq';
import type { Links } from '../data/faq';
import { rotas } from '../data/site';
// Perguntas contextuais no fim das páginas de programa (decisão dos sócios, 09/11/2026): no máximo duas, sempre com texto do FAQ central.
interface Props { ids: string[]; links: Links }
const { ids, links } = Astro.props;
const itens = perguntas(ids, links);
---
<script type="application/ld+json" set:html={JSON.stringify(faqSchema(itens))} />
<section class="wrap grid gap-5 md:gap-8 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-14" aria-labelledby="perguntas-titulo">
  <div class="flex flex-col items-start gap-5">
    <h2 id="perguntas-titulo" class="h2 !font-semibold">Perguntas frequentes</h2>
    <a href={rotas.faq} class="btn-l hidden lg:inline-flex">Ver todas as perguntas frequentes</a>
  </div>
  <Acordeao itens={itens} abrirPrimeira prefixo="pagina" />
  <a href={rotas.faq} class="btn-l w-full lg:hidden">Ver todas as perguntas frequentes</a>
</section>
