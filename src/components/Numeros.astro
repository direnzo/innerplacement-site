---
import Svg from './Svg.astro';
import { miolo } from '../lib/svg';
import nAnos from '../../imagens/inner-H21-calendario-v1.svg?raw';
import nPessoas from '../../imagens/inner-H22-multidao-v1.svg?raw';
import nPorcento from '../../imagens/inner-H23-rosca-v1.svg?raw';
import { numeros } from '../data/site';
const glifos = [nAnos, nPessoas, nPorcento];
---
<div class="mx-auto grid w-full max-w-[820px] grid-cols-3 gap-3 border-t border-tinta/15 pt-6 md:gap-10 md:pt-8">
  {numeros.map((n, i) => (
    <div class="relative flex flex-col items-center gap-2 text-center">
      <Svg name="oval_transparente" w={120} class="pointer-events-none absolute left-1/2 top-1/2 -z-0 h-auto w-[104px] -translate-x-1/2 -translate-y-1/2 opacity-60 md:w-[148px]" />
      <svg viewBox="0 0 96 64" class="relative h-11 w-auto md:h-16" aria-hidden="true" data-entrada set:html={miolo(glifos[i])} />
      <b data-conta class="relative text-[36px] font-semibold leading-none tracking-[-.02em] tabular-nums text-coral-d md:text-[57px]">{n.n}</b>
      <span class="relative max-w-[190px] text-[13px] leading-[1.4] text-texto md:text-[14px]">{n.t}</span>
    </div>
  ))}
</div>
