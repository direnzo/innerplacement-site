---
import IconeZap from './IconeZap.astro';
import { WHATSAPP_URL } from '../data/site';
---
<a href={WHATSAPP_URL} target="_blank" rel="noopener" aria-label="Chamar no WhatsApp"
  class="fixed bottom-[max(16px,env(safe-area-inset-bottom))] right-4 z-30 flex size-14 items-center justify-center gap-2.5 rounded-full bg-zap text-[#0E2F1C] shadow-[0_10px_28px_rgba(35,31,32,.22)] transition-transform hover:scale-105 lg:bottom-6 lg:right-8 lg:h-14 lg:w-auto lg:px-5 lg:pl-4">
  <IconeZap size={24} /><span class="hidden text-[15px] font-semibold lg:inline">WhatsApp</span>
</a>
