---
import Base from '../layouts/Base.astro';
import TopoPagina from '../components/TopoPagina.astro';
import ilustracao from '../../imagens/inner-P03-topo-executivos-v1.svg?raw';
import Programa from '../components/Programa.astro';
import DepoCard from '../components/DepoCard.astro';
import Badge from '../components/Badge.astro';
import { depoimentos as D } from '../data/depoimentos';
---
<Base titulo="Desenvolvimento de Executivos" fechamento
  descricao="Next Level para empresas: desenvolvimento de executivos que precisam chegar a um novo patamar, em espaço profissional e confidencial.">
  <TopoPagina titulo="Desenvolvimento de Executivos" trilha="Para sua empresa" ilustracao={ilustracao}
    intro="Há executivos que a empresa não quer perder — e que precisam chegar a um novo patamar: assumir uma área maior, ganhar peso nas decisões, mudar a forma de liderar. O Next Level é o programa da Inner para esse movimento: contratado pela empresa, construído com o executivo." />
  <section class="wrap grid gap-3.5 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:gap-6">
    <Programa para="empresa" rotulo="Desenvolvimento" nome="Next Level">Começa pelo impacto esperado, na carreira do executivo e na organização — definido com ele e alinhado com a empresa. A partir daí, construímos a estratégia de desenvolvimento para chegar lá: pode ser uma competência, um comportamento, a forma de se posicionar, ou o que só aparece no caminho. O programa se ajusta ao dia a dia do executivo: um espaço profissional e confidencial, adaptado ao contexto de cada um, para refletir, testar decisões e se preparar para os próximos movimentos.</Programa>
    <aside class="flex flex-col gap-3 rounded-[20px] bg-tinta p-5 text-white md:p-7">
      <Badge variante="coral">O que a empresa acompanha</Badge>
      <p class="text-[17px] leading-[1.55] md:text-[19px]">A evolução do executivo ao longo do programa — não o processo. O conteúdo das conversas é dele.</p>
    </aside>
  </section>
  <section class="wrap flex flex-col gap-5 pt-2" aria-labelledby="prova">
    <h2 id="prova" class="h2">Quem já fez esse caminho <strong>conta como foi.</strong></h2>
    <DepoCard d={D.christian} />
  </section>
</Base>
