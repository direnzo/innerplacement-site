---
// Página de cada post do blog, no mesmo endereço do WordPress (/<slug>/).
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { publicados, dataBR, minutos, miniaturas, LARGURAS_CARTAO, type Post } from '../lib/blog';
import { rotas } from '../data/site';
import { socios } from '../data/socios';
import { trilhaSchema } from '../lib/schema';

export async function getStaticPaths() {
  const posts = await publicados();
  // "Leia também": primeiro os posts do mesmo tema; o restante, do mais novo para o mais antigo.
  return posts.map((p) => {
    const demais = posts.filter((o) => o.id !== p.id);
    const mesmoTema = (o: Post) => Boolean(p.data.tema) && o.data.tema === p.data.tema;
    return { params: { slug: p.id }, props: { post: p, outros: [...demais.filter(mesmoTema), ...demais.filter((o) => !mesmoTema(o))].slice(0, 3) } };
  });
}
const { post, outros } = Astro.props as { post: Post; outros: Post[] };
const { Content } = await render(post);
const d = post.data;
const og = d.imagem ? (d.imagem.endsWith('.webp') ? d.imagem.replace(/\.webp$/, '-og.jpg') : d.imagem) : undefined;
const url = new URL(`/${post.id}/`, Astro.site).href;
// Referência à entidade completa que Base.astro declara na mesma página, ligada pelo @id.
const org = { '@id': 'https://innerplacement.com.br/#organizacao', name: 'Inner Placement', url: 'https://innerplacement.com.br/' };
const socio = socios.find((s) => s.id === d.autor);
const perfil = socio && new URL(`/quem-somos/#${socio.id}`, Astro.site).href;
const pessoa = socio && { '@type': 'Person', '@id': perfil, name: socio.nome, url: perfil };
// Só existe a data do post: o schema a declara à meia-noite de Brasília, com fuso, sem mudar o dia.
const dataHora = (x: Date) => `${x.toISOString().slice(0, 10)}T00:00:00-03:00`;
const schema = [{
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.titulo, description: d.descricao,
  datePublished: dataHora(d.data), dateModified: dataHora(d.atualizado ?? d.data),
  author: pessoa ?? org, publisher: org,
  mainEntityOfPage: url, ...(d.imagem && { image: new URL(d.imagem, Astro.site).href }),
}, trilhaSchema([['Blog', rotas.blog], [d.titulo]], Astro.site)];
---
<Base titulo={d.titulo_seo ?? d.titulo} descricao={d.descricao} fechamento ogImagem={og} tipo="article" schema={schema}>
  <article class="wrap flex flex-col gap-6 pt-6 md:gap-8 md:pt-10">
    <header class="mx-auto flex w-full max-w-[760px] flex-col gap-4">
      <p class="text-[14px] text-mudo"><a href="/" class="-my-3 inline-block py-3 hover:text-tinta">Início</a> / <a href={rotas.blog} class="-my-3 inline-block py-3 hover:text-tinta">Blog</a></p>
      {d.categorias.length > 0 && <p class="flex flex-wrap gap-2">{d.categorias.map((c) => <span class="badge">{c}</span>)}</p>}
      <h1 class="h1-pag">{d.titulo}</h1>
      <p class="text-[14.5px] text-mudo"><time datetime={d.data.toISOString().slice(0, 10)}>{dataBR(d.data)}</time> · {socio ? <a href={`${rotas.quemSomos}#${socio.id}`} class="underline underline-offset-2 hover:text-tinta">{socio.nome}</a> : d.autor} · {minutos(post.body)} min de leitura</p>
    </header>
    {d.imagem && <img src={d.imagem} alt={d.imagem_alt ?? ''} width="1600" height="900" class="mx-auto aspect-[16/9] w-full max-w-[960px] rounded-[24px] object-cover" decoding="async" fetchpriority="high" />}
    <div class="prosa mx-auto w-full max-w-[720px]"><Content /></div>
    <p class="mx-auto w-full max-w-[720px]"><a href={rotas.blog} class="btn-l">← Voltar para o blog</a></p>
  </article>
  {outros.length > 0 && (
    <section class="wrap flex flex-col gap-5" aria-labelledby="leia-tambem">
      <h2 id="leia-tambem" class="h2">Leia <strong>também</strong></h2>
      <div class="grid gap-4 md:grid-cols-3 md:gap-6">
        {outros.map((o) => (
          <a href={`/${o.id}/`} class="card group flex flex-col overflow-hidden">
            {o.data.imagem && <div class="aspect-[16/9] overflow-hidden bg-areia-c"><img src={o.data.imagem} srcset={miniaturas(o.data.imagem)} sizes={LARGURAS_CARTAO} alt="" width="640" height="360" loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" /></div>}
            <span class="flex flex-col gap-2 p-5"><span class="text-[17px] font-semibold leading-[1.3]">{o.data.titulo}</span><span class="text-[13.5px] text-mudo">{dataBR(o.data.data)}</span></span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
