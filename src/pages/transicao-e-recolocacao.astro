---
import Base from '../layouts/Base.astro';
import TopoPagina from '../components/TopoPagina.astro';
import Programa from '../components/Programa.astro';
import DepoCard from '../components/DepoCard.astro';
import DepoVideo from '../components/DepoVideo.astro';
import { depoimentos as D } from '../data/depoimentos';
---
<Base titulo="Transição e Recolocação" fechamento
  descricao="Transição de carreira com decisão fundamentada e execução precisa: programas Platinum e Focus, mesmo método, formatos distintos.">
  <TopoPagina titulo="Transição e Recolocação" trilha="Para você" acento="card_degrade" acentoClass="-right-16 -top-12 opacity-90"
    intro="Uma transição de carreira bem conduzida combina decisão fundamentada e execução precisa. A Inner estrutura esse trabalho em dois programas, Platinum e Focus — mesmo método, formatos distintos." />
  <section class="wrap grid gap-3.5 md:grid-cols-2 md:gap-6">
    <Programa rotulo="Transição" nome="Platinum">Para transições que exigem maior complexidade, profundidade e acompanhamento próximo. O Platinum combina reflexão, posicionamento e execução, com suporte individual e exclusivo em todas as etapas: leitura da sua trajetória com os sócios da Inner, definição de direcionamento, currículo e LinkedIn, ativação de network, job hunting e preparação para entrevistas. Uma consultora dedicada garante ritmo, organização e continuidade até a recolocação.</Programa>
    <Programa rotulo="Transição" nome="Focus">Para quem quer conduzir a própria transição com estrutura e suporte nos momentos decisivos. O Focus combina uma trilha estruturada — posicionamento, currículo, LinkedIn, network, preparação para entrevistas e orientação para a busca de oportunidades — com encontros individuais para definir a estratégia e preparar cada etapa da busca. Você conduz o processo com autonomia. Uma alternativa acessível, estruturada e efetiva para apoiar a sua recolocação.</Programa>
  </section>
  <section class="wrap flex flex-col gap-5 pt-2" aria-labelledby="prova">
    <h2 id="prova" class="h2">Quem já fez esse caminho <strong>conta como foi.</strong></h2>
    <DepoVideo d={D.rafael} />
    <DepoCard d={D.bruno} />
  </section>
</Base>
