---
import Base from '../layouts/Base.astro';
import TopoPagina from '../components/TopoPagina.astro';
import Acordeao from '../components/Acordeao.astro';
import { secoesFaq } from '../data/faq';
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: secoesFaq.flatMap((s) => s.perguntas).map((p) => ({ '@type': 'Question', name: p.q, acceptedAnswer: { '@type': 'Answer', text: p.a } })) };
---
<Base titulo="Perguntas frequentes" fechamento schema={schema}
  descricao="Perguntas frequentes sobre os programas da Inner Placement: primeira conversa, sigilo, Next Level, transição, outplacement e investimento.">
  <TopoPagina titulo="Perguntas frequentes" acento="rosacea_coral" acentoClass="-right-20 -bottom-24 w-[300px]! opacity-50">
    <nav aria-label="Seções" class="flex flex-wrap gap-2 pt-1">
      {secoesFaq.map((s) => <a href={`#${s.id}`} class="chip hover:bg-tinta hover:text-white">{s.titulo}</a>)}
    </nav>
  </TopoPagina>
  {secoesFaq.map((s, i) => (
    <section id={s.id} class="wrap grid scroll-mt-24 gap-4 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-14" aria-labelledby={`${s.id}-t`}>
      <h2 id={`${s.id}-t`} class="h2 !font-semibold lg:pt-4">{s.titulo}</h2>
      <Acordeao itens={s.perguntas} abrirPrimeira={i === 0} prefixo={s.id} />
    </section>
  ))}
</Base>
