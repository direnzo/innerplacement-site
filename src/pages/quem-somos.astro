---
import Base from '../layouts/Base.astro';
import TopoPagina from '../components/TopoPagina.astro';
import Svg from '../components/Svg.astro';
import ilustracao from '../../imagens/inner-P10-topo-quem-somos-v1.svg?raw';
import { abertura, socios } from '../data/socios';
// Quem somos: conteúdo da página do WordPress (src/data/socios.ts), no layout da v2.
---
<Base titulo="Quem somos" fechamento descricao={abertura}>
  <TopoPagina titulo="Quem somos" trilha="Inner" intro={abertura} ilustracao={ilustracao} />
  <section class="wrap flex flex-col gap-5 md:gap-7" aria-label="Sócios da Inner">
    {socios.map((s) => (
      <article id={s.id} class="card grid scroll-mt-24 gap-6 p-6 md:grid-cols-[220px_minmax(0,1fr)] md:gap-12 md:p-10" aria-labelledby={`${s.id}-nome`}>
        <div class="flex items-center gap-5 md:flex-col md:items-start md:gap-4">
          <!-- Moldura da foto do site antigo (pedido dos sócios): o arco em degradê coral, arredondado embaixo,
               por trás do recorte da pessoa; sem fundo, para funcionar sobre qualquer cor. -->
          <div class="socio-moldura w-[124px] shrink-0 md:w-[220px]">
            <img src={s.foto} alt={`Foto de ${s.nome}`} width="220" height="220" loading="lazy" decoding="async" class="socio-foto" />
          </div>
          <div class="flex flex-col items-start gap-3">
            <h2 id={`${s.id}-nome`} class="text-[24px] font-semibold leading-tight tracking-[-.01em] md:text-[26px]">{s.nome}</h2>
            <a href={s.linkedin} target="_blank" rel="noopener" class="inline-flex h-10 items-center gap-2 rounded-full bg-coral px-4 text-[14px] font-semibold text-tinta transition-colors hover:bg-tinta hover:text-white" aria-label={`LinkedIn de ${s.nome}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21H10V9Z"/></svg>
              LinkedIn
            </a>
          </div>
        </div>
        <div class="flex flex-col gap-5">
          <!-- A frase de cada sócio em destaque, numa moldura própria (pedido do dono) -->
          <blockquote class="socio-citacao text-[19px] font-light leading-[1.45] tracking-[-.01em] md:text-[23px]">
            <span class="socio-canto" aria-hidden="true"><Svg name="rosacea_coral" w={120} /></span>
            <svg class="socio-aspas" viewBox="0 0 48 36" aria-hidden="true"><path d="M8,26 a8,8 0 1 1 8,-8 q0,12 -10.7,17.3 l-2,-2.7 q5.4,-3.5 6.2,-7.2 a8,8 0 0 1 -1.5,.6 z M32,26 a8,8 0 1 1 8,-8 q0,12 -10.7,17.3 l-2,-2.7 q5.4,-3.5 6.2,-7.2 a8,8 0 0 1 -1.5,.6 z" fill="currentColor"/></svg>
            {s.citacao}
          </blockquote>
          {s.perfil.map((p) => <p class="text-[16px] leading-[1.65] text-texto md:text-[17px]">{p}</p>)}
          <p class="border-t border-linha pt-4 text-[14.5px] leading-[1.6] text-mudo md:text-[15px]">{s.formacao}</p>
        </div>
      </article>
    ))}
  </section>
</Base>
