---
import ilustracao from '../../docs/ilustracao/bloco-5/P08-contato.svg?raw';
import { miolo } from '../lib/svg';
import Base from '../layouts/Base.astro';
import IconeZap from '../components/IconeZap.astro';
import { WHATSAPP_URL, WHATSAPP_TXT, EMAIL, rotas } from '../data/site';
const campo = 'h-[52px] w-full rounded-full border-[1.5px] border-linha bg-white px-5 text-[16px] outline-none transition-colors focus:border-tinta';
---
<Base titulo="Contato" descricao="Vamos conversar. Conte o que você deseja. A Inner responde.">
  <section class="relative overflow-hidden bg-areia-c">
    <div class="wrap relative grid gap-7 py-9 md:py-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14">
      <div class="flex flex-col gap-4">
        <h1 class="h1-pag">Vamos conversar.</h1>
        <p class="lead">Conte o que você deseja. A Inner responde.</p>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn-l self-start"><IconeZap size={20} />Chamar no WhatsApp</a>
        <p class="text-[14px] leading-[1.5] text-texto">WhatsApp {WHATSAPP_TXT}<br />{EMAIL}</p>
        <!-- P-08: o envelope aberto, a carta com a rosácea e o cadeado da privacidade -->
        <svg viewBox="0 0 360 250" class="mt-2 hidden h-auto w-full max-w-[360px] lg:block" aria-hidden="true" data-entrada set:html={miolo(ilustracao)} />
      </div>

      <form action="/enviar.php" method="post" novalidate class="flex flex-col gap-4 rounded-[20px] bg-white p-5 md:p-7"
        x-data="contato" @submit="enviar($event)" data-obrigado={rotas.obrigado}>
        <input type="text" name="empresa_site" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <div class="flex flex-col gap-1.5">
          <label for="nome" class="text-[14px] font-semibold">Nome</label>
          <input id="nome" name="nome" type="text" autocomplete="name" required class={campo} x-model="f.nome" :aria-invalid="(!!erros.nome).toString()" />
          <p x-cloak x-show="erros.nome" class="text-[13.5px] text-coral-d" x-text="erros.nome"></p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-1.5">
            <label for="email" class="text-[14px] font-semibold">E-mail</label>
            <input id="email" name="email" type="email" autocomplete="email" class={campo} x-model="f.email" :aria-invalid="(!!erros.contato).toString()" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="whatsapp" class="text-[14px] font-semibold">WhatsApp</label>
            <input id="whatsapp" name="whatsapp" type="tel" autocomplete="tel" inputmode="tel" class={campo} x-model="f.whatsapp" :aria-invalid="(!!erros.contato).toString()" />
          </div>
        </div>
        <p x-cloak x-show="erros.contato" class="-mt-2 text-[13.5px] text-coral-d" x-text="erros.contato"></p>
        <div class="flex flex-col gap-1.5">
          <label for="mensagem" class="text-[14px] font-semibold">Sua mensagem</label>
          <textarea id="mensagem" name="mensagem" rows="6" required x-model="f.mensagem" :aria-invalid="(!!erros.mensagem).toString()"
            class="min-h-[150px] w-full resize-y rounded-[20px] border-[1.5px] border-linha bg-white px-5 py-3.5 text-[16px] outline-none transition-colors focus:border-tinta"></textarea>
          <p x-cloak x-show="erros.mensagem" class="text-[13.5px] text-coral-d" x-text="erros.mensagem"></p>
        </div>
        <p class="flex items-start gap-2.5 text-[14px] leading-[1.5] text-texto">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
          Seus dados ficam entre você e a Inner. Nenhum contato é feito sem a sua autorização.
        </p>
        <button type="submit" class="btn w-full sm:w-auto sm:self-start" :disabled="enviando">Enviar</button>
      </form>
    </div>
  </section>
</Base>

