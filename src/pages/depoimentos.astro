---
import Base from '../layouts/Base.astro';
import TopoPagina from '../components/TopoPagina.astro';
import ilustracao from '../../imagens/inner-P05-topo-depoimentos-v1.svg?raw';
import DepoCard from '../components/DepoCard.astro';
import DepoVideo from '../components/DepoVideo.astro';
import { depoimentos as D, secoesDepoimentos } from '../data/depoimentos';
import ComIcone from '../components/ComIcone.astro';
import tTransicao from '../../imagens/inner-T-transicao-v1.svg?raw';
import tOutplacement from '../../imagens/inner-T-outplacement-v1.svg?raw';
import tCrescimento from '../../imagens/inner-T-crescimento-v1.svg?raw';
// Ícone de cada seção (tools/ilustracao/titulos.mts); Transição e Crescimento também são usados no FAQ.
const icones: Record<string, string> = { 'secao-transicao': tTransicao, 'secao-outplacement': tOutplacement, 'secao-crescimento': tCrescimento };
---
<Base titulo="Depoimentos" fechamento
  descricao="Quem já fez esse caminho conta como foi: depoimentos reais de transição, outplacement e crescimento de carreira de clientes da Inner Placement.">
  <TopoPagina titulo="Depoimentos" migalhas={[['Depoimentos']]} ilustracao={ilustracao}
    intro="Não só o resultado. O processo inteiro, inclusive a parte difícil, que ninguém costuma mostrar.">
    <nav aria-label="Seções de depoimentos" class="flex flex-wrap gap-2 pt-1">
      {secoesDepoimentos.map((s) => <a href={`#${s.id}`} class="chip hover:bg-tinta hover:text-white">{s.titulo}</a>)}
    </nav>
  </TopoPagina>
  {secoesDepoimentos.map((s) => {
    const itens = s.ids.map((id) => D[id]);
    const videos = itens.filter((d) => d.video);
    const textos = itens.filter((d) => !d.video);
    return (
      <section id={s.id} class="wrap flex scroll-mt-24 flex-col gap-5" aria-labelledby={`${s.id}-t`}>
        <ComIcone svg={icones[s.id]}><h2 id={`${s.id}-t`} class="h2 !font-semibold">{s.titulo}</h2></ComIcone>
        {videos.length > 0 && <div class="grid gap-6 md:grid-cols-2">{videos.map((d) => <DepoVideo d={d} lado={false} />)}</div>}
        {textos.length > 0 && <div class="grid gap-3.5 md:grid-cols-2 md:gap-6">{textos.map((d) => <DepoCard d={d} />)}</div>}
      </section>
    );
  })}
</Base>
