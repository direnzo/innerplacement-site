---
import Base from '../layouts/Base.astro';
import Svg from '../components/Svg.astro';
import Caminhos from '../components/Caminhos.astro';
import Clientes from '../components/Clientes.astro';
import DepoCard from '../components/DepoCard.astro';
import DepoDestaque from '../components/DepoDestaque.astro';
import Acordeao from '../components/Acordeao.astro';
import Numeros from '../components/Numeros.astro';
import heroSvg from '../../imagens/inner-H01-hero-v4.svg?raw';
import h06 from '../../imagens/inner-H06-capa-video-v2.svg?raw';
import fBola from '../../imagens/inner-F01-bola-v1.svg?raw';
import fSetas from '../../imagens/inner-F03-chevrons-v1.svg?raw';
import fOval from '../../imagens/inner-F04-oval-v1.svg?raw';
import h09 from '../../imagens/inner-H09-baloes-v1.svg?raw';
import h10 from '../../imagens/inner-H10-oval-lapidado-v1.svg?raw';
import tProva from '../../imagens/inner-T-prova-v1.svg?raw';
import tMetodo from '../../imagens/inner-T-metodo-v1.svg?raw';
import ComIcone from '../components/ComIcone.astro';
import { miolo } from '../lib/svg';
import { depoimentos as D } from '../data/depoimentos';
import { faqHome } from '../data/faq';
import { rotas } from '../data/site';

// Painel do hero: H-01 aprovada (SVG gerado por tools/ilustracao/hero.mts), inline.
const painel = miolo(heroSvg);

// Formas de fundo: decorativas, nas bordas, com leve deslocamento na rolagem (.fundo-par).
const fundo = (svg: string, vb: string, cls: string) => `<svg viewBox="${vb}" class="fundo-par pointer-events-none absolute ${cls}" aria-hidden="true" data-rolagem="elemento">${miolo(svg)}</svg>`;

const dimensoes = [
  ['Pessoa e momento', 'Quem é esse profissional, o que construiu e o que está em jogo agora.'],
  ['Contexto', 'O ambiente em que atua, as relações, a cultura e o que esse cenário exige.'],
  ['Recursos e pontos de ajuste', 'O que já sustenta sua atuação e o que precisa ser ampliado, ajustado ou desenvolvido.'],
  ['Direção', 'Onde precisa chegar e o que será necessário para produzir esse movimento.'],
];
---
<Base titulo="Outplacement, transição e recolocação" fundo={false}
  fechamento={{ texto: 'Sobre o seu momento de carreira ou sobre a situação de um executivo da sua empresa. Sem apresentação de produto e sem compromisso.' }}
  descricao="A Inner Placement é uma consultoria que apoia executivos e empresas quando uma trajetória precisa avançar, ajustar-se ou fazer uma transição, com método, leitura cuidadosa e acompanhamento individual.">

  <!-- 1 · Hero: só a frase em grande destaque. A rosácea fica na lateral, sem passar por trás do
       texto (pedido do time, 10/11/2026): na borda direita a partir de 1024 px; abaixo disso, pequena
       no canto superior direito. O painel H-01 (heroSvg/painel) fica preservado no código para uso
       futuro, sem renderizar. -->
  <section class="relative isolate overflow-hidden">
    <Svg name="rosacea_coral" w={560} class="pointer-events-none absolute -right-[42px] -top-[42px] -z-10 h-auto w-[150px] opacity-[.45] lg:right-0 lg:top-1/2 lg:w-[clamp(340px,29vw,410px)] lg:translate-x-[30%] lg:-translate-y-1/2 lg:opacity-[.24]" />
    <div class="wrap flex flex-col items-center gap-4 pb-12 pt-[92px] text-center md:gap-5 md:pb-16 lg:items-start lg:py-20 lg:pr-[min(36%,400px)] lg:text-left [&_.badge]:self-center">
      <h1 class="h1-hero max-w-[24ch] text-[30px] md:text-[38px] lg:text-[46px] lg:leading-[1.12]">Momentos decisivos da trajetória executiva <strong>exigem clareza, contexto e precisão.</strong></h1>
      <p class="lead mx-auto max-w-[62ch] text-center text-[16.5px] md:text-[19px] lg:mx-0 lg:text-left">A Inner Placement é uma consultoria que apoia executivos e empresas quando uma trajetória precisa avançar, ajustar-se ou fazer uma transição, com método, leitura cuidadosa e acompanhamento individual.</p>
    </div>
    <!-- Futuro: painel H-01 guardado (heroSvg + painel + .hero-anim em global.css). Para reativar,
         voltar ao grid de duas colunas com o bloco abaixo.
    <div class="hero-anim flex flex-col gap-3 rounded-[28px] bg-areia-c p-4 md:p-6" data-rolagem>
      <svg viewBox="0 0 496 280" class="h-auto w-full" aria-hidden="true" set:html={painel} />
      <div class="@container flex justify-between gap-1.5 [&>.chip]:h-[2.6em] [&>.chip]:px-[.72em] [&>.chip]:text-[clamp(9.5px,calc(4.03cqi-0.48px),13px)]">
        <span class="chip h01-chip h01-chip-1">posicionamento</span>
        <span class="chip h01-chip h01-chip-2">network ativado</span>
        <span class="chip h01-chip h01-chip-3 !bg-tinta !text-white">até acontecer</span>
      </div>
    </div>
    -->
  </section>

  <!-- 2 · Caminhos -->
  <Caminhos />

  <!-- 3 · Como trabalhamos -->
  <section class="bloco relative isolate bg-white py-9 md:py-12" aria-labelledby="como-titulo">
    <Fragment set:html={fundo(fBola, '0 0 400 400', '-right-40 -top-40 -z-10 w-[340px] md:-right-32 md:-top-48 md:w-[460px]')} />
    <Fragment set:html={fundo(fSetas, '0 0 240 120', 'bottom-6 -left-10 -z-10 w-[160px] opacity-30 md:w-[220px]')} />
    <div class="wrap flex flex-col gap-6 md:gap-7">
      <ComIcone svg={tMetodo}><h2 id="como-titulo" class="h2">Carreira se decide com método, <strong>e se realiza com acompanhamento.</strong></h2></ComIcone>
      <div class="flex flex-col gap-2.5">
        <h3 class="text-[20px] font-semibold md:text-[22px]">Antes de mover, entender.</h3>
        <p class="lead !max-w-[78ch]">Nenhum movimento de carreira acontece fora de contexto. Antes de definir o próximo passo, entendemos quem é o profissional, o momento que está vivendo, o ambiente em que atua, o que já construiu e o que a situação exige. Essa leitura percorre quatro dimensões e dá precisão ao trabalho que vem depois.</p>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4" role="list">
        {dimensoes.map(([t, p]) => (
          <li class="flex flex-col gap-1.5 rounded-[20px] bg-areia-c p-5"><h4 class="text-[16px] font-semibold">{t}</h4><p class="text-[14.5px] leading-[1.55] text-texto">{p}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4 · Prova: formas de fundo nas bordas da página -->
  <div class="relative isolate flex flex-col gap-6 overflow-x-clip md:gap-8">
  <Fragment set:html={fundo(fOval, '0 0 200 280', '-left-24 top-24 -z-10 w-[150px] opacity-50 md:-left-16 md:w-[200px]')} />
  <Fragment set:html={fundo(fBola, '0 0 400 400', '-right-48 top-[45%] -z-10 w-[360px] md:-right-40 md:w-[520px]')} />
  <section class="wrap flex flex-col gap-6 pt-2 md:gap-7" aria-labelledby="prova-titulo">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-12">
      <div class="flex max-w-[640px] flex-col gap-2.5">
        <ComIcone svg={tProva}><h2 id="prova-titulo" class="h2">Quem já fez esse caminho <strong>conta como foi.</strong></h2></ComIcone>
        <p class="lead">Não só o resultado. O processo inteiro, inclusive a parte difícil, que ninguém costuma mostrar.</p>
      </div>
      <a href={rotas.depoimentos} class="btn-l hidden md:inline-flex">Ver todos os depoimentos</a>
    </div>
    <DepoDestaque d={D.gisele} capa={h06} inicial />
    <div class="grid gap-3.5 md:grid-cols-2 md:gap-6">
      <DepoCard d={D.gustavo} />
      <DepoCard d={D.christian} />
    </div>
    <Numeros />
    <Clientes />
    <a href={rotas.depoimentos} class="btn-l w-full md:hidden">Ver todos os depoimentos</a>
  </section>
  </div>

  <!-- 5 · Perguntas -->
  <section class="wrap grid gap-5 md:gap-8 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-14" aria-labelledby="perguntas-titulo">
    <div class="flex flex-col items-start gap-5">
      <div class="flex items-center gap-3 md:gap-4 lg:flex-col lg:items-start">
        <svg viewBox="0 0 140 104" class="h-[64px] w-auto shrink-0 md:h-[88px] lg:h-[104px]" aria-hidden="true" data-entrada set:html={miolo(h09)} />
        <h2 id="perguntas-titulo" class="h2">Antes de conversar, <strong>o que costumam perguntar</strong></h2>
      </div>
      <a href={rotas.faq} class="btn-l hidden lg:inline-flex">Ver todas as perguntas</a>
    </div>
    <Acordeao itens={faqHome} abrirPrimeira prefixo="home" />
    <a href={rotas.faq} class="btn-l w-full lg:hidden">Ver todas as perguntas</a>
  </section>

  <!-- 6 · Manifesto -->
  <section class="wrap" aria-labelledby="manifesto-titulo">
    <div class="relative grid gap-5 overflow-hidden rounded-[28px] bg-white p-6 md:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] md:items-center md:gap-14 md:p-11">
      <div class="relative flex items-center gap-4 md:gap-6">
        <!-- H-10: a pedra facetada vira o oval liso com a rolagem ("lapidamos") -->
        <svg viewBox="0 0 240 200" class="h-[104px] w-auto shrink-0 overflow-visible md:h-[150px]" aria-hidden="true" data-rolagem="elemento" set:html={miolo(h10)} />
        <div class="flex flex-col items-start gap-4">
          <h2 id="manifesto-titulo" class="h2 !font-semibold">Manifesto</h2>
          <a href={rotas.manifesto} class="btn-l hidden md:inline-flex">Ler o manifesto</a>
        </div>
      </div>
      <blockquote class="relative text-[20px] font-light leading-[1.4] tracking-[-.01em] md:text-[27px]"><span class="font-semibold text-coral">“</span>Não reinventamos ninguém. Lapidamos o que cada pessoa já construiu, ampliando consciência, repertório e capacidade de agir.<span class="font-semibold text-coral">”</span></blockquote>
      <a href={rotas.manifesto} class="btn-l relative w-full md:hidden">Ler o manifesto</a>
    </div>
  </section>
</Base>
